# ==============================================================================
# RoadPulse — Environment Configuration Template
# Copy this file to .env and fill in your Supabase project values
# DO NOT COMMIT REAL KEYS OR SECRETS TO REPOSITORY
# ==============================================================================

# Supabase Public API Configuration
# Safe for client-side consumption via Row Level Security (RLS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# Optional: Local Server Port
PORT=3000

# Feature Flags
ENABLE_SUPABASE_PERSISTENCE=false
ENABLE_AUDIO_CHIME=true
